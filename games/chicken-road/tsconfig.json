{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"], "isolatedModules": true
  },
  "include": ["src", "test"],
  "exclude": ["test/real-core.ts"]
}
